  <mxfile host="app.diagrams.net">
    <diagram name="Arquitectura Local (Simulación AWS)">
      <mxGraphModel>
        <root>
          <mxCell id="0"/>
          <mxCell id="1" parent="0"/>

          <mxCell id="ui" value="Angular Frontend&#10;(Dashboards + UX)" style="rounded=1;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="20" width="260" height="60" as="geometry"/>
          </mxCell>

          <mxCell id="api" value="Express API&#10;(Simula API Gateway)" style="rounded=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="110" width="260" height="60" as="geometry"/>
          </mxCell>

          <mxCell id="controllers" value="Controllers&#10;(Routing HTTP)" style="rounded=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="200" width="260" height="60" as="geometry"/>
          </mxCell>

          <mxCell id="services" value="Services&#10;(Lógica negocio / Lambda)" style="rounded=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="290" width="260" height="60" as="geometry"/>
          </mxCell>

          <mxCell id="repos" value="Repositories&#10;(Simula DynamoDB)" style="rounded=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="380" width="260" height="60" as="geometry"/>
          </mxCell>

          <mxCell id="data" value="Mock Data&#10;(metrics.data.js / ejecucion.data.js)" style="rounded=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=12;" vertex="1" parent="1">
            <mxGeometry x="380" y="470" width="260" height="60" as="geometry"/>
          </mxCell>

          <!-- Arrows -->
          <mxCell id="e1" style="endArrow=block" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
          <mxCell id="e2" style="endArrow=block" edge="1" parent="1" source="api" target="controllers"><mxGeometry relative="1" as="geometry"/></mxCell>
          <mxCell id="e3" style="endArrow=block" edge="1" parent="1" source="controllers" target="services"><mxGeometry relative="1" as="geometry"/></mxCell>
          <mxCell id="e4" style="endArrow=block" edge="1" parent="1" source="services" target="repos"><mxGeometry relative="1" as="geometry"/></mxCell>
          <mxCell id="e5" style="endArrow=block" edge="1" parent="1" source="repos" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>

        </root>
      </mxGraphModel>
    </diagram>  
  </mxfile>
